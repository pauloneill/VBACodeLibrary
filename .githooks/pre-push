#!/bin/sh
# pre-push hook: run the static VBA checks before anything leaves your machine.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip in an emergency:    git push --no-verify
#
# Runs scripts/check.sh, but only when the push touches VBA source or the check script itself
# (docs-only pushes are not slowed down). VBA cannot be compiled outside Access/Excel/Word, so
# compiling and running the code in the host application stays a manual step (see REVIEW.md).

ZERO="0000000000000000000000000000000000000000"
PATHS='^(src/|scripts/)'

needs_check=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    needs_check=1
    continue
  fi
  if git diff --name-only "$remote_sha" "$local_sha" | grep -Eq "$PATHS"; then
    needs_check=1
  fi
done

if [ "$needs_check" -eq 0 ]; then
  echo "pre-push: no code changes, skipping checks."
  exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

echo "pre-push: scripts/check.sh"
if ! sh scripts/check.sh; then
  echo ""
  echo "pre-push: checks failed. Push cancelled. (Override: git push --no-verify)"
  exit 1
fi

echo "pre-push: all checks passed."
exit 0
